package components

import "github.com/diegovhdev/yortale/web"

// Layout es la estructura HTML común a todas las páginas.
// Los scripts con componentes de Alpine (Alpine.data) van antes que alpine.min.js: se
// registran en el evento alpine:init, y defer los ejecuta en el orden en que aparecen.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · YorTale</title>
			<meta name="color-scheme" content="dark"/>
			<link rel="stylesheet" href={ web.Asset("css/themes.css") }/>
			<link rel="stylesheet" href={ web.Asset("css/global.css") }/>
			<link rel="stylesheet" href={ web.Asset("css/app.css") }/>
			<script src={ web.Asset("js/htmx.min.js") } defer></script>
			<script src={ web.Asset("js/genre-checks.js") } defer></script>
			<script src={ web.Asset("js/warning-checks.js") } defer></script>
			<script src={ web.Asset("js/tag-picker.js") } defer></script>
			<script src={ web.Asset("js/alpine.min.js") } defer></script>
		</head>
		<body>
			<header>
				<a href="/"><strong>YorTale</strong></a>
				<nav>
					<a href="/stories">Explorar</a>
					<a href="/stories/new">Escribir</a>
					<a href="/my/stories">Mis historias</a>
				</nav>
			</header>
			<main>
				{ children... }
			</main>
			<footer>
				<a href="/terms">Términos de uso</a> · <a href="/privacy">Privacidad</a>
			</footer>
		</body>
	</html>
}
