package pages

import "github.com/diegovhdev/yortale/web/components"

templ LoginPage(f LoginForm) {
	@components.Layout("Iniciar sesión") {
		<h1>Iniciar sesión</h1>
		@LoginFormFragment(f)
		<p>¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
	}
}

templ LoginFormFragment(f LoginForm) {
	<form
		id="login-form"
		action="/iniciar-sesion"
		method="post"
		hx-post="/iniciar-sesion"
		hx-target="this"
		hx-swap="outerHTML"
		hx-disable="find button"
	>
		if f.General != "" {
			<p class="error" role="alert">{ f.General }</p>
		}
		@components.Field(components.FieldProps{
			Label:        "Usuario o correo",
			Name:         "login",
			Type:         "text",
			Value:        f.Login,
			Autocomplete: "username",
			Required:     true,
		})
		@components.Field(components.FieldProps{
			Label:        "Contraseña",
			Name:         "password",
			Type:         "password",
			Autocomplete: "current-password",
			Required:     true,
		})
		<button type="submit">Entrar</button>
		<span class="htmx-indicator">Entrando…</span>
	</form>
}
