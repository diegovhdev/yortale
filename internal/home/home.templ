package home

import (
	"github.com/diegovhdev/yortale/internal/auth"
	"github.com/diegovhdev/yortale/web/components"
)

// HomePage es temporal: solo sirve para comprobar que la sesión funciona.
templ HomePage(user *auth.User) {
	@components.Layout("Inicio") {
		if user != nil {
			<h1>Hola, { user.Name() }</h1>
			<p>Iniciaste sesión como <strong>{ user.Username }</strong> ({ user.Email }).</p>
			<p><a href="/stories">Explora historias</a> o <a href="/my/stories">sigue escribiendo las tuyas</a>.</p>
			<form action="/logout" method="post">
				<button type="submit">Cerrar sesión</button>
			</form>
		} else {
			<h1>Bienvenido a YorTale</h1>
			<p>
				<a href="/login">Inicia sesión</a> o <a href="/register">crea una cuenta</a>.
			</p>
			<p><a href="/stories">Explora las historias publicadas</a>.</p>
		}
	}
}
