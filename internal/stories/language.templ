package stories

import (
	"strconv"

	"github.com/diegovhdev/yortale/web/components"
)

// LanguagesPage es la página de administración de idiomas: todos, activos o no, y el
// formulario para agregar uno nuevo.
templ LanguagesPage(langs []Language, f LanguageForm) {
	@components.Layout("Idiomas") {
		<h1>Idiomas</h1>
		@adminNav()
		<p class="hint">
			Son los idiomas que los autores pueden elegir para sus historias. Desactivar uno lo quita
			del formulario, pero las historias que ya lo tienen lo conservan.
		</p>
		<table class="data-table">
			<thead>
				<tr>
					<th scope="col">Código</th>
					<th scope="col">Nombre</th>
					<th scope="col">Estado</th>
					<th scope="col"><span class="sr-only">Acciones</span></th>
				</tr>
			</thead>
			<tbody>
				for _, l := range langs {
					<tr>
						<td><code>{ l.Code }</code></td>
						<td lang={ l.Code }>{ l.Name }</td>
						<td>
							if l.Active {
								Activo
							} else {
								<span class="hint">Inactivo</span>
							}
						</td>
						<td><a href={ templ.URL(l.EditURL()) }>Editar</a></td>
					</tr>
				}
			</tbody>
		</table>
		<h2>Agregar idioma</h2>
		@LanguageFormFragment(f)
	}
}

// EditLanguagePage es la página para renombrar un idioma o activarlo y desactivarlo.
templ EditLanguagePage(f LanguageForm) {
	@components.Layout("Editar idioma") {
		<h1>Editar idioma <code>{ f.Code }</code></h1>
		@LanguageFormFragment(f)
	}
}

// LanguageFormFragment es el formulario de idioma; htmx lo reemplaza completo si hay errores.
templ LanguageFormFragment(f LanguageForm) {
	<form
		id="language-form"
		action={ templ.URL(f.Action) }
		method="post"
		hx-post={ f.Action }
		hx-target="this"
		hx-swap="outerHTML"
		hx-disable="find button"
	>
		if f.General != "" {
			<p class="error" role="alert">{ f.General }</p>
		}
		if f.IsNew {
			@components.Field(components.FieldProps{
				Label:    "Código (ISO 639, con región opcional: es, ast, pt-BR). No se puede cambiar después.",
				Name:     "code",
				Type:     "text",
				Value:    f.Code,
				Error:    f.Errors["code"],
				Required: true,
				Attrs:    templ.Attributes{"maxlength": "6", "autocomplete": "off", "spellcheck": "false"},
			})
		}
		@components.Field(components.FieldProps{
			Label:    "Nombre, en el propio idioma (Español, English, Português do Brasil)",
			Name:     "name",
			Type:     "text",
			Value:    f.Name,
			Error:    f.Errors["name"],
			Required: true,
			Attrs:    templ.Attributes{"maxlength": strconv.Itoa(maxLanguageNameRunes)},
		})
		<div class="field">
			<label>
				<input type="checkbox" name="active" value="1" checked?={ f.Active }/>
				Activo (los autores pueden elegirlo)
			</label>
		</div>
		<button type="submit">
			if f.IsNew {
				Agregar idioma
			} else {
				Guardar cambios
			}
		</button>
		if !f.IsNew {
			<a href={ templ.URL(languagesURL) }>Cancelar</a>
		}
		<span class="htmx-indicator">Guardando…</span>
	</form>
}
