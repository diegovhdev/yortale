package stories

import (
	"strconv"

	"github.com/diegovhdev/yortale/internal/auth"
	"github.com/diegovhdev/yortale/web/components"
)

templ ExplorePage(v ExploreView) {
	@components.Layout("Explorar historias") {
		<h1>Explorar historias</h1>
		<form class="search" action="/stories" method="get" role="search">
			<div class="field">
				<label for="q">Buscar</label>
				<input type="search" id="q" name="q" value={ v.Query } maxlength="200" placeholder="Título o palabras de la sinopsis"/>
			</div>
			@genreFilter(v)
			@components.Select(components.SelectProps{
				Label:   "Tipo",
				Name:    "kind",
				Value:   v.Kind,
				Options: kindOptions("Todos"),
			})
			<button type="submit">Buscar</button>
		</form>
		if len(v.Stories) == 0 {
			if v.Filtered() {
				<p>No encontramos historias con esa búsqueda.</p>
			} else {
				<p>Todavía no hay historias publicadas. <a href="/stories/new">¡Escribe la primera!</a></p>
			}
		} else {
			<ul class="story-list">
				for _, s := range v.Stories {
					@storyCard(s, true, false)
				}
			</ul>
		}
		if v.Page > 1 || v.HasNext {
			<nav class="pagination">
				if v.Page > 1 {
					<a href={ templ.URL(v.PageURL(v.Page - 1)) } rel="prev">← Anterior</a>
				}
				<span>Página { strconv.Itoa(v.Page) }</span>
				if v.HasNext {
					<a href={ templ.URL(v.PageURL(v.Page + 1)) } rel="next">Siguiente →</a>
				}
			</nav>
		}
	}
}

templ MyStoriesPage(user *auth.User, stories []Story) {
	@components.Layout("Mis historias") {
		<h1>Mis historias</h1>
		<p class="actions">
			<a href="/stories/new">Nueva historia</a>
			<a href={ templ.URL(user.ProfileURL()) }>Ver mi perfil público</a>
			<a href="/settings/profile">Editar perfil</a>
		</p>
		if len(stories) == 0 {
			<p>Aún no has escrito ninguna historia.</p>
		} else {
			<ul class="story-list">
				for _, s := range stories {
					@storyCard(s, false, true)
				}
			</ul>
		}
	}
}

// storyCard es una historia dentro de un listado. showAuthor añade el «por …» (sobra en
// «Mis historias» y en el perfil del autor); authorActions, los enlaces para editarla.
templ storyCard(s Story, showAuthor, authorActions bool) {
	<li class="story-card">
		<h2><a href={ templ.URL(s.URL()) }>{ s.Title }</a></h2>
		if showAuthor {
			<p>
				por{ " " }
				@authorLink(s, false)
			</p>
		}
		@storyMeta(s)
		if s.Synopsis != "" {
			<p>{ excerpt(s.Synopsis, 300) }</p>
		}
		if authorActions {
			<p class="actions">
				<a href={ templ.URL(s.NewChapterURL()) }>Nuevo capítulo</a>
				<a href={ templ.URL(s.EditURL()) }>Editar</a>
			</p>
		}
	</li>
}

// genreFilter son las casillas de géneros del buscador: la historia debe tener todos los
// marcados, en cualquier orden. Sin JS se envían todas las marcadas y el servidor se queda
// con las primeras maxGenres; con el componente genreFilter de Alpine
// (web/static/js/genre-checks.js), al llegar a maxGenres se desactivan las demás.
templ genreFilter(v ExploreView) {
	<fieldset
		class="genre-picker"
		x-data="genreFilter"
		data-selected={ v.SelectedGenresJSON() }
		data-max={ strconv.Itoa(maxGenres) }
		@pageshow.window="resync()"
	>
		<legend>Géneros (hasta { strconv.Itoa(maxGenres) }; la historia debe tenerlos todos)</legend>
		<div class="genre-options">
			for _, g := range v.Genres {
				<label class="genre-option">
					<input
						type="checkbox"
						name="genre"
						value={ strconv.Itoa(int(g.ID)) }
						checked?={ v.HasGenre(g.ID) }
						autocomplete="off"
						x-model="selected"
						:disabled={ "isBlocked('" + strconv.Itoa(int(g.ID)) + "')" }
					/>
					<span>{ g.Name }</span>
				</label>
			}
		</div>
	</fieldset>
}
