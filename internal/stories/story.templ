package stories

import (
	"strconv"

	"github.com/diegovhdev/yortale/web/components"
)

templ StoryPage(v StoryView) {
	@components.Layout(v.Story.Title) {
		<article class="story">
			<h1>{ v.Story.Title }</h1>
			<p>
				por{ " " }
				@authorLink(v.Story, true)
			</p>
			@storyMeta(v.Story)
			@storyWarnings(v.Story)
			@storyTags(v.Story.Tags, 0)
			if v.Story.IsDraft() {
				<p class="notice">Esta historia es un borrador: solo tú puedes verla. Se publica al publicar su primer capítulo.</p>
			}
			@hiddenNotice(v.Story)
			if v.Story.Synopsis != "" {
				<div class="synopsis">
					for _, p := range paragraphs(v.Story.Synopsis) {
						<p>{ p }</p>
					}
				</div>
			}
			if v.IsAuthor {
				<p class="actions">
					<a href={ templ.URL(v.Story.NewChapterURL()) }>Nuevo capítulo</a>
					<a href={ templ.URL(v.Story.EditURL()) }>Editar historia</a>
					<a href={ templ.URL(v.Story.DeleteURL()) }>Borrar historia</a>
				</p>
			}
			@storyFlags(v.Story, v.IsStaff, v.CanReport(), v.Story.ReportURL())
			<h2>Capítulos</h2>
			if len(v.Chapters) == 0 {
				<p>Todavía no hay capítulos publicados.</p>
			} else if v.IsAuthor {
				@authorChapterList(v)
			} else {
				@staticChapterList(v, nil)
			}
		</article>
	}
}

// hiddenNotice avisa de que la moderación ocultó la historia. Solo pueden verla así su autor
// y el equipo de moderación (ver Service.Visible).
templ hiddenNotice(s Story) {
	if s.IsHidden() {
		<p class="notice notice-danger">
			Esta historia está oculta por moderación desde el { formatDate(*s.HiddenAt) }: no aparece en
			ningún listado y solo la ven su autor y el equipo de moderación.
			if s.HiddenReason != "" {
				Motivo: { s.HiddenReason }
			}
		</p>
	}
}

// storyFlags son los enlaces discretos para reportar la historia o un capítulo (reportURL) y,
// para el equipo, para moderarla.
templ storyFlags(s Story, staff, canReport bool, reportURL string) {
	if staff || canReport {
		<p class="flags">
			if staff {
				<a href={ templ.URL(s.ModerationURL()) }>Moderar</a>
			}
			if canReport {
				<a href={ templ.URL(reportURL) } rel="nofollow">Reportar</a>
			}
		</p>
	}
}

// staticChapterList es el índice de capítulos dibujado en el servidor: el de los lectores, y
// el del autor sin JS (con chapterActions). attrs permite ocultarlo cuando Alpine dibuja el
// del autor.
templ staticChapterList(v StoryView, attrs templ.Attributes) {
	<ol class="chapter-list" { attrs... }>
		for i, c := range v.Chapters {
			<li>
				<a href={ templ.URL(c.URL(v.Story)) }>{ c.Title }</a>
				if !c.IsPublished {
					<small>(borrador)</small>
				}
				if v.IsAuthor {
					@chapterActions(c, canMoveChapter(v.Chapters, i, -1), canMoveChapter(v.Chapters, i, 1))
				}
			</li>
		}
	</ol>
}

// authorChapterList es el índice del autor, con reordenación optimista (componente
// chapterOrder de web/static/js/chapter-order.js): con JS, Alpine dibuja la lista desde
// data-chapters, las flechas mueven el capítulo al instante y la petición va por detrás; si
// el servidor responde con error, vuelve al último orden confirmado. Sin JS se ve la lista
// del servidor, cuyas flechas son formularios POST que recargan la página.
templ authorChapterList(v StoryView) {
	<div x-data="chapterOrder" data-chapters={ v.ChaptersJSON() }>
		<p class="error" role="alert" x-cloak x-show="error" x-text="error"></p>
		<p class="sr-only" aria-live="polite" x-text="status"></p>
		@staticChapterList(v, templ.Attributes{"x-show": "false"})
		<template x-if="true">
			<ol class="chapter-list">
				<template x-for="(c, i) in chapters" :key="c.id">
					<li>
						<a :href="c.url" x-text="c.title"></a>
						<small x-show="c.draft">(borrador)</small>
						<span class="actions">
							<template x-if="c.draft">
								<form method="post" :action="c.publishURL">
									<button type="submit" class="publish" :aria-label="'Publicar ' + c.title">Publicar</button>
								</form>
							</template>
							<a :href="c.editURL">Editar</a>
							<a :href="c.deleteURL">Borrar</a>
							<button
								type="button"
								x-show="canMove(i, -1)"
								:data-move="c.id + '-up'"
								:aria-label="'Subir ' + c.title"
								title="Subir"
								@click="move(i, -1)"
							>↑</button>
							<button
								type="button"
								x-show="canMove(i, 1)"
								:data-move="c.id + '-down'"
								:aria-label="'Bajar ' + c.title"
								title="Bajar"
								@click="move(i, 1)"
							>↓</button>
						</span>
					</li>
				</template>
			</ol>
		</template>
	</div>
}

// chapterActions son los controles del autor en el índice. Publicar (solo en borradores) y
// mover usan formularios POST normales: cambian datos, así que no pueden ser enlaces GET.
templ chapterActions(c Chapter, canUp, canDown bool) {
	<span class="actions">
		if !c.IsPublished {
			<form method="post" action={ templ.URL(c.PublishURL()) }>
				<button type="submit" class="publish" aria-label={ "Publicar " + c.Title }>Publicar</button>
			</form>
		}
		<a href={ templ.URL(c.EditURL()) }>Editar</a>
		<a href={ templ.URL(c.DeleteURL()) }>Borrar</a>
		if canUp {
			<form method="post" action={ templ.URL(c.MoveURL()) }>
				<input type="hidden" name="direction" value="up"/>
				<button type="submit" aria-label={ "Subir " + c.Title } title="Subir">↑</button>
			</form>
		}
		if canDown {
			<form method="post" action={ templ.URL(c.MoveURL()) }>
				<input type="hidden" name="direction" value="down"/>
				<button type="submit" aria-label={ "Bajar " + c.Title } title="Bajar">↓</button>
			</form>
		}
	</span>
}

// authorLink enlaza al perfil del autor. El nombre para mostrar no es único, así que el
// @username (que sí lo es) va siempre en el title del enlace y, con showHandle, también a la
// vista, para que nadie pueda hacerse pasar por otro autor copiando su nombre. Si el autor no
// tiene nombre para mostrar, AuthorName ya es el username y no se repite.
templ authorLink(s Story, showHandle bool) {
	<a href={ templ.URL(s.AuthorURL()) } title={ "@" + s.AuthorUsername }>{ s.AuthorName }</a>
	if showHandle && s.AuthorName != s.AuthorUsername {
		<span class="handle">{ "@" + s.AuthorUsername }</span>
	}
}

// storyMeta es la línea de datos de una historia. El tipo y los géneros enlazan a explorar
// ya filtrado, para saltar a historias parecidas.
templ storyMeta(s Story) {
	<p class="meta">
		<a href={ templ.URL(s.KindURL()) }>{ s.KindLabel() }</a> ·
		if len(s.Genres) > 0 {
			for i, g := range s.Genres {
				if i > 0 {
					,
				}
				<a href={ templ.URL(g.URL()) }>{ g.Name }</a>
			}
			·
		}
		{ s.ContentRatingLabel() } · { s.StatusLabel() } · { s.LanguageLabel() } ·
		{ plural(int64(s.ChapterCount), "capítulo", "capítulos") } ·
		{ plural(s.ReadsCount, "lector", "lectores") }
		if s.PublishedAt != nil {
			· publicada el { formatDate(*s.PublishedAt) }
		}
		if s.UpdatedLater() {
			· actualizada el { formatDate(*s.LastChapterAt) }
		}
	</p>
}

// storyWarnings son las advertencias de contenido, en su propia línea para que se vean antes
// de empezar a leer.
templ storyWarnings(s Story) {
	<p class="warnings">
		<strong>Advertencias:</strong>
		for i, label := range s.WarningLabels() {
			if i > 0 {
				,
			}
			{ label }
		}
	</p>
}

// storyTags son los tags de una historia, cada uno enlazado a su página. hidden es cuántos
// más tiene y no se muestran (en las tarjetas de los listados solo caben maxCardTags).
templ storyTags(tags []Tag, hidden int) {
	if len(tags) > 0 {
		<ul class="tags" aria-label="Tags">
			for _, t := range tags {
				<li><a href={ templ.URL(t.URL()) }>{ t.Name }</a></li>
			}
			if hidden > 0 {
				<li class="more">{ "y " + strconv.Itoa(hidden) + " más" }</li>
			}
		</ul>
	}
}

templ ConfirmDeletePage(c ConfirmDelete) {
	@components.Layout(c.Title) {
		<h1>{ c.Title }</h1>
		<p>{ c.Message }</p>
		<form method="post" action={ templ.URL(c.Action) }>
			<button type="submit">Sí, borrar</button>
			<a href={ templ.URL(c.CancelURL) }>Cancelar</a>
		</form>
	}
}

