package stories

import (
	"strconv"

	"github.com/diegovhdev/yortale/web/components"
)

templ NewStoryPage(f StoryForm) {
	@components.Layout("Nueva historia") {
		<h1>Nueva historia</h1>
		<p>La historia empieza como borrador: nadie más la verá hasta que publiques su primer capítulo.</p>
		@StoryFormFragment(f)
	}
}

templ EditStoryPage(f StoryForm) {
	@components.Layout("Editar historia") {
		<h1>Editar historia</h1>
		@StoryFormFragment(f)
	}
}

// StoryFormFragment sirve para crear y para editar; f.Action indica a dónde se envía.
templ StoryFormFragment(f StoryForm) {
	<form
		id="story-form"
		action={ templ.URL(f.Action) }
		method="post"
		hx-post={ f.Action }
		hx-target="this"
		hx-swap="outerHTML"
		hx-disable="find button"
	>
		if f.General != "" {
			<p class="error" role="alert">{ f.General }</p>
		}
		@components.Field(components.FieldProps{
			Label:    "Título",
			Name:     "title",
			Type:     "text",
			Value:    f.Title,
			Error:    f.Errors["title"],
			Required: true,
			Attrs:    templ.Attributes{"maxlength": "200"},
		})
		@components.TextArea(components.FieldProps{
			Label: "Sinopsis",
			Name:  "synopsis",
			Value: f.Synopsis,
			Error: f.Errors["synopsis"],
			Attrs: templ.Attributes{"rows": "6", "maxlength": "4000"},
		})
		@components.Radios(components.RadioProps{
			Legend:  "Tipo",
			Name:    "kind",
			Value:   f.Kind,
			Error:   f.Errors["kind"],
			Options: Kinds,
		})
		@genreChecks(f)
		@tagPicker(f)
		@components.Select(components.SelectProps{
			Label:    "Idioma",
			Name:     "language",
			Value:    f.Language,
			Error:    f.Errors["language"],
			Options:  Languages,
			Required: true,
		})
		@components.Select(components.SelectProps{
			Label:    "Clasificación",
			Name:     "content_rating",
			Value:    f.ContentRating,
			Error:    f.Errors["content_rating"],
			Options:  ContentRatings,
			Required: true,
		})
		@warningChecks(f)
		if !f.IsNew {
			@components.Select(components.SelectProps{
				Label:    "Estado",
				Name:     "status",
				Value:    f.Status,
				Error:    f.Errors["status"],
				Options:  Statuses,
				Required: true,
			})
		}
		<button type="submit">
			if f.IsNew {
				Crear historia
			} else {
				Guardar cambios
			}
		</button>
		<a href={ templ.URL(f.CancelURL) }>Cancelar</a>
		<span class="htmx-indicator">Guardando…</span>
	</form>
}

// genreChecks es el campo de géneros: una casilla con estilo de etiqueta por género, en el
// orden de ListGenres (alfabético).
//
// Sin JS, las casillas envían los marcados en ese orden alfabético.
// Con JS, el componente genreChecks de Alpine (web/static/js/genre-checks.js) guarda los
// marcados en el orden en que se marcan y los muestra debajo, en una vista previa con ×.
// Esa vista previa envía los inputs ocultos en ese orden, y las casillas pierden su name
// (:name="null") para no enviarlos dos veces.
templ genreChecks(f StoryForm) {
	<fieldset
		class="genre-picker"
		x-data="genreChecks"
		data-genres={ f.GenreChoicesJSON() }
		data-selected={ f.SelectedGenresJSON() }
		data-max={ strconv.Itoa(maxGenres) }
		@pageshow.window="resync()"
		if f.Errors[genresField] != "" {
			aria-describedby="genres-error"
		}
	>
		<legend>Géneros (hasta { strconv.Itoa(maxGenres) })</legend>
		<p class="hint" x-cloak>Se muestran en el orden en que los marques.</p>
		<div class="genre-options" x-ref="options">
			for _, g := range f.Genres {
				<label class="genre-option">
					<input
						type="checkbox"
						name={ genresField }
						value={ strconv.Itoa(int(g.ID)) }
						checked?={ f.HasGenre(g.ID) }
						autocomplete="off"
						x-model="selected"
						:name="null"
						:disabled={ "isBlocked('" + strconv.Itoa(int(g.ID)) + "')" }
					/>
					<span>{ g.Name }</span>
				</label>
			}
		</div>
		<div class="genre-preview" x-cloak x-show="selected.length > 0">
			<p class="hint" id="genre-preview-label">Así se mostrarán:</p>
			<ol x-ref="preview" aria-labelledby="genre-preview-label">
				<template x-for="(id, i) in selected" :key="id">
					<li :data-id="id">
						<input type="hidden" name="genres" :value="id"/>
						<span x-text="nameOf(id)"></span>
						<button type="button" class="remove" :aria-label="'Quitar ' + nameOf(id)" @click="remove(i)">×</button>
					</li>
				</template>
			</ol>
		</div>
		if f.Errors[genresField] != "" {
			<small id="genres-error" class="error">{ f.Errors[genresField] }</small>
		}
	</fieldset>
}

// warningChecks es el campo de advertencias de contenido: una casilla por advertencia, con su
// explicación. Es obligatorio elegir al menos una, y «No aplica ninguna» va sola; las dos
// reglas las valida el servidor. Con JS, el componente warningChecks de Alpine
// (web/static/js/warning-checks.js) desmarca las incompatibles al marcar una.
templ warningChecks(f StoryForm) {
	<fieldset
		class="warning-checks"
		x-data="warningChecks"
		data-selected={ f.WarningsJSON() }
		@pageshow.window="resync()"
		if f.Errors[warningsField] != "" {
			aria-describedby="warnings-error"
		}
	>
		<legend>Advertencias de contenido</legend>
		<p class="hint">Marca todas las que apliquen, para que cada lector decida si quiere leerla.</p>
		for _, w := range ContentWarnings {
			<label>
				<input
					type="checkbox"
					name={ warningsField }
					value={ w.Value }
					checked?={ f.HasWarning(w.Value) }
					autocomplete="off"
					x-model="selected"
				/>
				<span>
					<strong>{ w.Label }</strong>
					<small>{ w.Description }</small>
				</span>
			</label>
		}
		if f.Errors[warningsField] != "" {
			<small id="warnings-error" class="error">{ f.Errors[warningsField] }</small>
		}
	</fieldset>
}

// tagPicker es el campo de tags, opcional.
//
// Sin JS es un texto con los tags separados por comas, en el orden en que se escriben.
// Con JS, el componente tagPicker de Alpine (web/static/js/tag-picker.js) muestra los tags
// como etiquetas que se ordenan arrastrando (o con ← →), y el texto pasa a servir para
// escribir el siguiente, con sugerencias de tags que ya existen. Cada etiqueta envía un input
// oculto "tags" en su orden. El texto conserva su name, así que un tag escrito y sin
// confirmar también se envía: el servidor separa por comas y quita los repetidos.
templ tagPicker(f StoryForm) {
	<fieldset
		class="tag-picker"
		x-data="tagPicker"
		data-selected={ f.TagsJSON() }
		data-max={ strconv.Itoa(maxTags) }
		data-max-length={ strconv.Itoa(maxTagRunes) }
		data-suggest-url="/api/tags"
		if f.Errors[tagsField] != "" {
			aria-describedby="tags-error"
		}
	>
		<legend>Tags (opcional, hasta { strconv.Itoa(maxTags) })</legend>
		<p class="hint" x-show="false">
			Sepáralos con comas, en el orden en que quieras mostrarlos. Si un tag ya existe se usa
			ese, aunque lo escribas con otras mayúsculas o sin tildes.
		</p>
		<p class="hint" x-cloak>
			Pulsa Enter o escribe una coma para añadir cada tag, y arrástralos para ordenarlos. Si un
			tag ya existe se usa ese, aunque lo escribas con otras mayúsculas o sin tildes.
		</p>
		<ul
			class="tag-chips"
			aria-label="Tags elegidos"
			x-cloak
			x-show="selected.length > 0"
			x-ref="list"
			@pointermove.window="drag($event)"
			@pointerup.window="endDrag()"
			@pointercancel.window="endDrag()"
		>
			<template x-for="(t, i) in selected" :key="t.key">
				<li
					class="tag-chip"
					tabindex="0"
					:data-key="t.key"
					:class="{ dragging: dragging === t.key }"
					@pointerdown="startDrag($event, t)"
					@keydown.arrow-left.prevent="move(i, -1)"
					@keydown.arrow-right.prevent="move(i, 1)"
					@keydown.delete.prevent="remove(i)"
					@keydown.backspace.prevent="remove(i)"
				>
					<input type="hidden" name={ tagsField } :value="t.name"/>
					<span x-text="t.name"></span>
					<button type="button" class="remove" :aria-label="'Quitar ' + t.name" @click="remove(i)">×</button>
				</li>
			</template>
		</ul>
		<input
			type="text"
			id="tags-input"
			name={ tagsField }
			value={ f.TagsText() }
			aria-label="Tags"
			list="tag-suggestions"
			autocomplete="off"
			x-ref="input"
			x-model="draft"
			:placeholder="full ? 'Llegaste al máximo de tags' : 'Escribe un tag'"
			:disabled="full"
			@input="onInput($event)"
			@input.debounce.250ms="suggest()"
			@keydown.enter="onEnter($event)"
		/>
		<datalist id="tag-suggestions">
			<template x-for="t in suggestions" :key="t.slug">
				<option :value="t.name" :label="t.uses === 1 ? '1 historia' : t.uses + ' historias'"></option>
			</template>
		</datalist>
		<small class="error" role="status" x-cloak x-show="problem" x-text="problem"></small>
		if f.Errors[tagsField] != "" {
			<small id="tags-error" class="error">{ f.Errors[tagsField] }</small>
		}
	</fieldset>
}
