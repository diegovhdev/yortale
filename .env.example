# Copia este archivo como .env y rellena los valores. No subas .env a git.

# Cadena de conexión de Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.us-east-2.aws.neon.tech/yortale?sslmode=require

PORT=8080

# development: cookies sin Secure (http://localhost)
# production: cookies solo por HTTPS
APP_ENV=development
